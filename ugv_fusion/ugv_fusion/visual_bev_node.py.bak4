import array
import numpy as np
import cupy as cp
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import PointCloud2
from nav_msgs.msg import OccupancyGrid
import tf2_ros

# Nav2 / OccupancyGrid cell states
UNKNOWN, FREE, OCCUPIED = -1, 0, 100

_DATATYPES = {1: np.int8, 2: np.uint8, 3: np.int16, 4: np.uint16,
              5: np.int32, 6: np.uint32, 7: np.float32, 8: np.float64}


def cloud_to_xyz(msg):
    """Zero-copy structured-array read of a PointCloud2 (replaces read_points_list)."""
    names, formats, offsets = [], [], []
    for f in msg.fields:
        if f.datatype not in _DATATYPES or f.name in names:
            continue
        names.append(f.name)
        formats.append(_DATATYPES[f.datatype])
        offsets.append(f.offset)
    dt = np.dtype({'names': names, 'formats': formats,
                   'offsets': offsets, 'itemsize': msg.point_step})
    n = msg.width * msg.height
    arr = np.frombuffer(msg.data, dtype=dt, count=n)
    xyz = np.empty((n, 3), dtype=np.float32)
    xyz[:, 0] = arr['x']
    xyz[:, 1] = arr['y']
    xyz[:, 2] = arr['z']
    return xyz


def transform_to_matrix(t):
    """geometry_msgs TransformStamped -> 4x4 homogeneous matrix."""
    q = t.transform.rotation
    x, y, z, w = q.x, q.y, q.z, q.w
    M = np.eye(4, dtype=np.float32)
    M[0, 0] = 1 - 2 * (y * y + z * z)
    M[0, 1] = 2 * (x * y - z * w)
    M[0, 2] = 2 * (x * z + y * w)
    M[1, 0] = 2 * (x * y + z * w)
    M[1, 1] = 1 - 2 * (x * x + z * z)
    M[1, 2] = 2 * (y * z - x * w)
    M[2, 0] = 2 * (x * z - y * w)
    M[2, 1] = 2 * (y * z + x * w)
    M[2, 2] = 1 - 2 * (x * x + y * y)
    M[0, 3] = t.transform.translation.x
    M[1, 3] = t.transform.translation.y
    M[2, 3] = t.transform.translation.z
    return M


class VisualBEVNode(Node):
    def __init__(self):
        super().__init__('visual_bev_node')

        self.declare_parameter('resolution', 0.10)
        self.declare_parameter('grid_size_x', 50.0)
        self.declare_parameter('grid_size_y', 30.0)
        self.declare_parameter('offset_x', -5.0)
        self.declare_parameter('min_z', 0.10)
        self.declare_parameter('max_z', 2.00)
        # TRUE stereo horizon. Must match the ZED 'max depth' setting (currently 15 m).
        # Beyond this the camera has NO evidence and must report UNKNOWN, never FREE.
        self.declare_parameter('camera_max_range', 15.0)

        gp = self.get_parameter
        self.resolution = gp('resolution').value
        self.grid_size_x = gp('grid_size_x').value
        self.grid_size_y = gp('grid_size_y').value
        self.offset_x = gp('offset_x').value
        self.min_z = gp('min_z').value
        self.max_z = gp('max_z').value
        self.cam_max_range = gp('camera_max_range').value

        self.width = int((self.grid_size_x - self.offset_x) / self.resolution)   # X cells
        self.height = int(self.grid_size_y / self.resolution)                    # Y cells

        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)

        self.sub_cloud = self.create_subscription(
            PointCloud2, '/zed/zed_node/point_cloud/cloud_registered',
            self.cloud_callback, qos_profile_sensor_data)
        self.pub_grid = self.create_publisher(OccupancyGrid, '/planning/visual_bev_grid', 10)

        self.get_logger().info(
            f"Visual BEV (3-state) started. Grid {self.width}x{self.height} @ "
            f"{self.resolution}m, camera horizon {self.cam_max_range}m.")

    def cloud_callback(self, msg):
        try:
            tf = self.tf_buffer.lookup_transform('base_link', msg.header.frame_id,
                                                 rclpy.time.Time())
        except Exception as e:
            self.get_logger().warn(f"TF error: {e}", throttle_duration_sec=2.0)
            return

        pts_cpu = cloud_to_xyz(msg)
        if pts_cpu.shape[0] == 0:
            return

        pts = cp.asarray(pts_cpu)
        finite = cp.isfinite(pts).all(axis=1)
        pts = pts[finite]
        if pts.shape[0] == 0:
            return

        # Rotate/translate into base_link on the GPU (replaces CPU do_transform_cloud)
        M = cp.asarray(transform_to_matrix(tf))
        pts = pts @ M[:3, :3].T + M[:3, 3]

        x, y, z = pts[:, 0], pts[:, 1], pts[:, 2]
        rng = cp.sqrt(x * x + y * y)

        in_grid = (x >= self.offset_x) & (x < self.grid_size_x) & \
                  (y >= -self.grid_size_y / 2) & (y < self.grid_size_y / 2) & \
                  (rng <= self.cam_max_range)
        if not bool(in_grid.any()):
            return
        x, y, z = x[in_grid], y[in_grid], z[in_grid]

        xi = ((x - self.offset_x) / self.resolution).astype(cp.int32)
        yi = ((y + self.grid_size_y / 2) / self.resolution).astype(cp.int32)
        xi = cp.clip(xi, 0, self.width - 1)
        yi = cp.clip(yi, 0, self.height - 1)
        flat = yi * self.width + xi   # row-major: index = y * info.width + x

        # THREE-STATE: start UNKNOWN. Only cells with actual returns get asserted.
        grid = cp.full(self.width * self.height, UNKNOWN, dtype=cp.int8)

        # --- Free-space carving ---
        # A cell is only FREE if a return LANDS in it, which leaves holes where the
        # cloud is sparse at range. Everything along the ray from the camera to a
        # measured point is observed empty, so carve it. Without this the camera
        # asserts FREE in ~2% of cells and the conflict factor K can never fire.
        sx, sy = float(M[0, 3]), float(M[1, 3])
        max_rays = 20000
        if x.shape[0] > max_rays:
            ri = cp.linspace(0, x.shape[0] - 1, max_rays).astype(cp.int32)
            rxs, rys = x[ri], y[ri]
        else:
            rxs, rys = x, y
        t = cp.linspace(0.02, 0.97, 170).reshape(1, -1)   # stop short of the hit itself
        fx = (sx + (rxs.reshape(-1, 1) - sx) * t).ravel()
        fy = (sy + (rys.reshape(-1, 1) - sy) * t).ravel()
        fxi = ((fx - self.offset_x) / self.resolution).astype(cp.int32)
        fyi = ((fy + self.grid_size_y / 2) / self.resolution).astype(cp.int32)
        ok = (fxi >= 0) & (fxi < self.width) & (fyi >= 0) & (fyi < self.height)
        grid[fyi[ok] * self.width + fxi[ok]] = FREE

        ground = z < self.min_z
        obstacle = (z >= self.min_z) & (z <= self.max_z)

        grid[flat[ground]] = FREE          # ground observed -> traversable
        grid[flat[obstacle]] = OCCUPIED    # obstacle wins over free (applied second)

        self.publish_grid(cp.asnumpy(grid), msg.header.stamp)

    def publish_grid(self, grid_flat, stamp):
        g = OccupancyGrid()
        g.header.stamp = stamp
        g.header.frame_id = 'base_link'
        g.info.resolution = self.resolution
        g.info.width = self.width
        g.info.height = self.height
        g.info.origin.position.x = float(self.offset_x)
        g.info.origin.position.y = float(-self.grid_size_y / 2)
        g.info.origin.position.z = 0.0
        g.info.origin.orientation.w = 1.0
        g.data = array.array('b', grid_flat.astype(np.int8).tobytes())
        self.pub_grid.publish(g)


def main(args=None):
    rclpy.init(args=args)
    rclpy.spin(VisualBEVNode())
    rclpy.shutdown()


if __name__ == '__main__':
    main()
