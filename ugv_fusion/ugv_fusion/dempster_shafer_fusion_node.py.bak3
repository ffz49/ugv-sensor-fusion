import rclpy
from rclpy.node import Node
from nav_msgs.msg import OccupancyGrid
from std_msgs.msg import Float32, Float32MultiArray, Header
from sensor_msgs.msg import PointCloud2, PointField, PointField
from visualization_msgs.msg import Marker
import sensor_msgs_py.point_cloud2 as pc2
import array
import array
import cupy as cp
import numpy as np


class DempsterShaferFusionNode(Node):
    def __init__(self):
        super().__init__('dempster_shafer_fusion_node')

        # Evidential weights (default = full trust until clarity nodes report).
        self.alpha = 1.0  # visual clarity
        self.beta = 1.0   # radar clarity
        self.create_subscription(Float32, '/environment/visual_clarity', self.alpha_callback, 10)
        self.create_subscription(Float32, '/environment/radar_beta', self.beta_callback, 10)

        # Latest grids cached by ARRIVAL. The two sensor streams run at different
        # rates and on different clocks, so ApproximateTimeSynchronizer never matched.
        # We cache the newest of each and fuse on a fixed timer instead.
        self.visual_grid = None
        self.radar_grid = None
        self.visual_time = None
        self.radar_time = None
        self.stale_sec = 1.0  # a modality older than this is treated as vacuous (unknown)

        self.create_subscription(OccupancyGrid, '/planning/visual_bev_grid', self.visual_callback, 10)
        self.create_subscription(OccupancyGrid, '/planning/radar_bev_grid', self.radar_callback, 10)

        # Publishers
        self.pub_fused_grid = self.create_publisher(OccupancyGrid, '/planning/fused_bev_grid', 10)
        self.pub_fused_cloud = self.create_publisher(PointCloud2, '/planning/fused_memory_cloud', 10)
        self.pub_status_text = self.create_publisher(Marker, '/planning/fusion_status_text', 10)
        self.pub_latency = self.create_publisher(Float32, '/fusion/latency_ms', 10)
        self.weight_pub = self.create_publisher(Float32MultiArray, '/fusion/ds_weights', 10)

        # Fuse on a fixed timer, decoupled from sensor arrival. 10 Hz; tune if needed.
        self.fuse_timer = self.create_timer(0.1, self.fuse_grids)

        self.get_logger().info("GPU-Accelerated Dempster-Shafer Fusion Node Started (timer-driven).")

    def alpha_callback(self, msg):
        self.alpha = float(msg.data)

    def beta_callback(self, msg):
        self.beta = float(msg.data)

    def visual_callback(self, msg):
        self.visual_grid = msg
        self.visual_time = self.get_clock().now()

    def radar_callback(self, msg):
        self.radar_grid = msg
        self.radar_time = self.get_clock().now()

    def fuse_grids(self):
        now = self.get_clock().now()

        vis_fresh = (self.visual_grid is not None and
                     (now - self.visual_time).nanoseconds * 1e-9 < self.stale_sec)
        rad_fresh = (self.radar_grid is not None and
                     (now - self.radar_time).nanoseconds * 1e-9 < self.stale_sec)

        if not vis_fresh and not rad_fresh:
            return  # nothing recent to fuse

        # Reference grid supplies geometry (prefer the camera grid).
        ref = self.visual_grid if vis_fresh else self.radar_grid
        res = ref.info.resolution
        w = ref.info.width
        h = ref.info.height
        n = w * h
        ox = float(ref.info.origin.position.x)
        oy = float(ref.info.origin.position.y)

        # Guard against mismatched sizes (should not happen with identical config).
        if vis_fresh and len(self.visual_grid.data) != n:
            return
        if rad_fresh and len(self.radar_grid.data) != n:
            return

        idx = cp.arange(n)
        cols = (idx % w).astype(cp.float32)   # forward (x) cell index
        rows = (idx // w).astype(cp.float32)  # lateral (y) cell index

        # --- Camera belief masses (distance-weighted; vacuous if stale) ---
        if vis_fresh:
            cam = cp.array(self.visual_grid.data, dtype=cp.float32)
            x_fwd = ox + cols * res
            y_lat = oy + rows * res
            dist = cp.sqrt(x_fwd * x_fwd + y_lat * y_lat)
            # Camera trust decays linearly from 1.0 at 15 m to 0.0 at 30 m.
            cam_dw = cp.clip(1.0 - (dist - 10.0) / 5.0, 0.0, 1.0)
            eff_alpha = self.alpha * cam_dw
            m_c_occ = cp.where(cam == 100, 0.9 * eff_alpha, 0.0)
            m_c_free = cp.where(cam == 0, 0.9 * eff_alpha, 0.0)
        else:
            m_c_occ = cp.zeros(n, dtype=cp.float32)
            m_c_free = cp.zeros(n, dtype=cp.float32)
        m_c_unk = 1.0 - m_c_occ - m_c_free

        # --- Radar belief masses (vacuous if stale) ---
        if rad_fresh:
            rad = cp.array(self.radar_grid.data, dtype=cp.float32)
            m_r_occ = cp.where(rad == 100, 0.9 * self.beta, 0.0)
            m_r_free = cp.where(rad == 0, 0.9 * self.beta, 0.0)
        else:
            m_r_occ = cp.zeros(n, dtype=cp.float32)
            m_r_free = cp.zeros(n, dtype=cp.float32)
        m_r_unk = 1.0 - m_r_occ - m_r_free

        # --- Dempster's rule of combination ---
        K = cp.clip((m_c_occ * m_r_free) + (m_c_free * m_r_occ), 0.0, 0.99)
        denom = 1.0 - K
        m_fused_occ = (m_c_occ * m_r_occ + m_c_occ * m_r_unk + m_c_unk * m_r_occ) / denom
        m_fused_free = (m_c_free * m_r_free + m_c_free * m_r_unk + m_c_unk * m_r_free) / denom

        # --- Decision: -1 unknown, 0 free, 100 occupied (Nav2 convention, no rescaling) ---
        fused = cp.full(n, -1, dtype=cp.int8)
        fused[m_fused_occ > 0.5] = 100
        fused[(m_fused_free > 0.5) & (m_fused_occ <= 0.5)] = 0
        fused_cpu = cp.asnumpy(fused)

        out = OccupancyGrid()
        out.header.stamp = now.to_msg()
        out.header.frame_id = 'base_link'
        out.info = ref.info
        out.data = array.array('b', fused_cpu.astype(np.int8).tobytes())
        self.pub_fused_grid.publish(out)

        wmsg = Float32MultiArray()
        wmsg.data = [float(self.alpha), float(self.beta)]
        self.weight_pub.publish(wmsg)

        # Fusion-stage latency (grid arrival -> fused), clock-consistent.
        # NOTE: true sensor-to-fusion latency needs ZED/radar clock alignment.
        ref_time = self.visual_time if vis_fresh else self.radar_time
        lat = Float32()
        lat.data = float((now - ref_time).nanoseconds * 1e-9 * 1000.0)
        self.pub_latency.publish(lat)

        self.publish_status_marker()

        # --- Occupied cells -> PointCloud2 for Nav2 global memory layer ---
        occ_flat = np.where(fused_cpu == 100)[0]
        if occ_flat.size > 0:
            # Cap cloud size: Nav2 only needs the local window, and huge clouds stall it.
            if occ_flat.size > 20000:
                occ_flat = occ_flat[np.linspace(0, occ_flat.size - 1, 20000).astype(np.int64)]
            rows_i = (occ_flat // w).astype(np.float32)
            cols_i = (occ_flat % w).astype(np.float32)
            pts = np.empty((occ_flat.size, 3), dtype=np.float32)
            pts[:, 0] = ox + cols_i * res
            pts[:, 1] = oy + rows_i * res
            pts[:, 2] = 0.0
            pc = PointCloud2()
            pc.header.stamp = now.to_msg()
            pc.header.frame_id = 'base_link'
            pc.height = 1
            pc.width = int(pts.shape[0])
            pc.fields = [
                PointField(name='x', offset=0, datatype=PointField.FLOAT32, count=1),
                PointField(name='y', offset=4, datatype=PointField.FLOAT32, count=1),
                PointField(name='z', offset=8, datatype=PointField.FLOAT32, count=1)]
            pc.is_bigendian = False
            pc.point_step = 12
            pc.row_step = 12 * int(pts.shape[0])
            pc.is_dense = True
            pc.data = array.array('B', pts.tobytes())
            self.pub_fused_cloud.publish(pc)

    def publish_status_marker(self):
        marker = Marker()
        marker.header.frame_id = "base_link"
        marker.header.stamp = self.get_clock().now().to_msg()
        marker.ns = "fusion_status"
        marker.id = 0
        marker.type = Marker.TEXT_VIEW_FACING
        marker.action = Marker.ADD
        marker.pose.position.z = 2.0
        marker.scale.z = 0.4
        marker.color.a = 1.0
        marker.color.r = marker.color.g = marker.color.b = 1.0
        marker.text = f"Visual Alpha: {self.alpha:.2f}\nRadar Beta: {self.beta:.2f}"
        self.pub_status_text.publish(marker)


def main(args=None):
    rclpy.init(args=args)
    node = DempsterShaferFusionNode()
    rclpy.spin(node)
    rclpy.shutdown()


if __name__ == '__main__':
    main()
