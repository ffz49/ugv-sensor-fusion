import array
import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import PointCloud2
from nav_msgs.msg import OccupancyGrid
import tf2_ros

UNKNOWN, FREE, OCCUPIED = -1, 0, 100

_DATATYPES = {1: np.int8, 2: np.uint8, 3: np.int16, 4: np.uint16,
              5: np.int32, 6: np.uint32, 7: np.float32, 8: np.float64}


def cloud_to_fields(msg, wanted):
    names, formats, offsets = [], [], []
    for f in msg.fields:
        if f.datatype not in _DATATYPES or f.name in names:
            continue
        names.append(f.name)
        formats.append(_DATATYPES[f.datatype])
        offsets.append(f.offset)
    dt = np.dtype({'names': names, 'formats': formats,
                   'offsets': offsets, 'itemsize': msg.point_step})
    n = msg.width * msg.height
    arr = np.frombuffer(msg.data, dtype=dt, count=n)
    out = {}
    for w in wanted:
        out[w] = np.asarray(arr[w], dtype=np.float32) if w in names else np.zeros(n, np.float32)
    return out


def transform_to_matrix(t):
    q = t.transform.rotation
    x, y, z, w = q.x, q.y, q.z, q.w
    M = np.eye(4, dtype=np.float32)
    M[0, 0] = 1 - 2 * (y * y + z * z); M[0, 1] = 2 * (x * y - z * w); M[0, 2] = 2 * (x * z + y * w)
    M[1, 0] = 2 * (x * y + z * w); M[1, 1] = 1 - 2 * (x * x + z * z); M[1, 2] = 2 * (y * z - x * w)
    M[2, 0] = 2 * (x * z - y * w); M[2, 1] = 2 * (y * z + x * w); M[2, 2] = 1 - 2 * (x * x + y * y)
    M[0, 3] = t.transform.translation.x
    M[1, 3] = t.transform.translation.y
    M[2, 3] = t.transform.translation.z
    return M


class RadarBEVNode(Node):
    def __init__(self):
        super().__init__('radar_bev_node')

        self.declare_parameter('resolution', 0.10)
        self.declare_parameter('grid_size_x', 50.0)
        self.declare_parameter('grid_size_y', 30.0)
        self.declare_parameter('offset_x', -5.0)
        self.declare_parameter('min_z', 0.10)
        self.declare_parameter('max_z', 2.00)
        # DRVEGRD 166 elevation accuracy is 0.25-1.0 deg, so the usable z-window must
        # widen with range or genuine long-range obstacles are filtered away.
        self.declare_parameter('z_tolerance_per_m', 0.02)
        # RCS gate tapers with range so weak far-field returns are not discarded.
        self.declare_parameter('rcs_min_near', 5.0)
        self.declare_parameter('rcs_taper_range', 40.0)
        # Persistence held in the ODOM frame -> no ghosting/smearing as the UGV drives.
        self.declare_parameter('persistence_sec', 0.5)
        self.declare_parameter('angular_beam_deg', 0.5)

        gp = self.get_parameter
        self.resolution = gp('resolution').value
        self.grid_size_x = gp('grid_size_x').value
        self.grid_size_y = gp('grid_size_y').value
        self.offset_x = gp('offset_x').value
        self.min_z = gp('min_z').value
        self.max_z = gp('max_z').value
        self.z_tol_per_m = gp('z_tolerance_per_m').value
        self.rcs_min_near = gp('rcs_min_near').value
        self.rcs_taper_range = gp('rcs_taper_range').value
        self.persistence_sec = gp('persistence_sec').value
        self.beam_rad = np.deg2rad(gp('angular_beam_deg').value)

        self.width = int((self.grid_size_x - self.offset_x) / self.resolution)
        self.height = int(self.grid_size_y / self.resolution)

        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)

        self.history = []          # list of (stamp_sec, Nx3 odom-frame points)
        self.odom_available = True

        self.sub_radar = self.create_subscription(
            PointCloud2, '/smart_radar/port_targets_0',
            self.radar_callback, qos_profile_sensor_data)
        self.pub_grid = self.create_publisher(OccupancyGrid, '/planning/radar_bev_grid', 10)

        self.get_logger().info(
            f"Radar BEV (3-state, odom-persistent) started. Grid {self.width}x{self.height}.")

    def radar_callback(self, msg):
        try:
            tf_bl = self.tf_buffer.lookup_transform('base_link', msg.header.frame_id,
                                                    rclpy.time.Time())
        except Exception as e:
            self.get_logger().warn(f"Radar TF error: {e}", throttle_duration_sec=2.0)
            return

        f = cloud_to_fields(msg, ('x', 'y', 'z', 'rcs', 'radial_speed'))
        n = f['x'].shape[0]
        if n == 0:
            self.publish_from_history(msg.header.stamp)
            return

        pts = np.stack([f['x'], f['y'], f['z']], axis=1)
        good = np.isfinite(pts).all(axis=1)
        pts, rcs = pts[good], f['rcs'][good]
        if pts.shape[0] == 0:
            self.publish_from_history(msg.header.stamp)
            return

        M = transform_to_matrix(tf_bl)
        pts = pts @ M[:3, :3].T + M[:3, 3]

        x, y, z = pts[:, 0], pts[:, 1], pts[:, 2]
        rng = np.sqrt(x * x + y * y)

        # Range-aware elevation window (angular error grows with distance)
        z_tol = self.z_tol_per_m * rng
        z_ok = (z > (self.min_z - z_tol)) & (z < (self.max_z + z_tol))

        # Range-tapered RCS gate
        rcs_gate = self.rcs_min_near * np.clip(1.0 - rng / self.rcs_taper_range, 0.0, 1.0)
        rcs_ok = rcs > rcs_gate

        in_grid = (x >= self.offset_x) & (x < self.grid_size_x) & \
                  (y >= -self.grid_size_y / 2) & (y < self.grid_size_y / 2)

        keep = z_ok & rcs_ok & in_grid
        pts_bl = pts[keep]

        # Store detections in ODOM so persistence does not smear while driving.
        now = self.get_clock().now().nanoseconds * 1e-9
        try:
            tf_od = self.tf_buffer.lookup_transform('odom', 'base_link', rclpy.time.Time())
            Mo = transform_to_matrix(tf_od)
            if pts_bl.shape[0] > 0:
                self.history.append((now, pts_bl @ Mo[:3, :3].T + Mo[:3, 3]))
            self.history = [(t, p) for (t, p) in self.history
                            if now - t <= self.persistence_sec]
            self.odom_available = True
        except Exception:
            # odom->base_link missing (e.g. UGV driver not running): fall back to
            # instantaneous, non-persistent operation so fusion still functions.
            if self.odom_available:
                self.get_logger().warn(
                    "odom->base_link unavailable: radar persistence disabled "
                    "(instantaneous mode).", throttle_duration_sec=10.0)
            self.odom_available = False
            self.history = [(now, pts_bl)] if pts_bl.shape[0] > 0 else []

        self.publish_from_history(msg.header.stamp)

    def gather_base_link_points(self):
        if not self.history:
            return np.empty((0, 3), np.float32)
        allpts = np.concatenate([p for (_, p) in self.history], axis=0)
        if not self.odom_available:
            return allpts
        try:
            tf_od = self.tf_buffer.lookup_transform('odom', 'base_link', rclpy.time.Time())
            Mo = transform_to_matrix(tf_od)
            R, t = Mo[:3, :3], Mo[:3, 3]
            return (allpts - t) @ R      # inverse transform: odom -> base_link
        except Exception:
            return np.empty((0, 3), np.float32)

    def publish_from_history(self, stamp):
        # THREE-STATE: radar starts fully UNKNOWN. Absence of a return is NOT
        # evidence of free space, so this node never writes FREE.
        grid = np.full(self.width * self.height, UNKNOWN, dtype=np.int8)

        pts = self.gather_base_link_points()
        if pts.shape[0] > 0:
            x, y = pts[:, 0], pts[:, 1]
            inb = (x >= self.offset_x) & (x < self.grid_size_x) & \
                  (y >= -self.grid_size_y / 2) & (y < self.grid_size_y / 2)
            x, y = x[inb], y[inb]
            if x.shape[0] > 0:
                rng = np.sqrt(x * x + y * y)
                # Cross-range uncertainty grows with distance -> range-scaled splat
                radius = np.clip((rng * np.tan(self.beam_rad)) / self.resolution,
                                 2, 8).astype(np.int32)
                xi = ((x - self.offset_x) / self.resolution).astype(np.int32)
                yi = ((y + self.grid_size_y / 2) / self.resolution).astype(np.int32)
                rmax = int(radius.max())
                for dx in range(-rmax, rmax + 1):
                    for dy in range(-rmax, rmax + 1):
                        m = (np.abs(dx) <= radius) & (np.abs(dy) <= radius)
                        if not m.any():
                            continue
                        nx = np.clip(xi[m] + dx, 0, self.width - 1)
                        ny = np.clip(yi[m] + dy, 0, self.height - 1)
                        grid[ny * self.width + nx] = OCCUPIED

        g = OccupancyGrid()
        g.header.stamp = stamp
        g.header.frame_id = 'base_link'
        g.info.resolution = self.resolution
        g.info.width = self.width
        g.info.height = self.height
        g.info.origin.position.x = float(self.offset_x)
        g.info.origin.position.y = float(-self.grid_size_y / 2)
        g.info.origin.position.z = 0.0
        g.info.origin.orientation.w = 1.0
        g.data = array.array('b', grid.astype(np.int8).tobytes())
        self.pub_grid.publish(g)


def main(args=None):
    rclpy.init(args=args)
    rclpy.spin(RadarBEVNode())
    rclpy.shutdown()


if __name__ == '__main__':
    main()
